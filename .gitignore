
# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments and local environment settings
.venv/
venv/
env/
.env
.env.*

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Source videos: do not commit video data
videos/*
!videos/.gitkeep

# Video files: exclude source and generated videos globally
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4v
*.mpeg
*.mpg
*.wmv
*.flv

# Generated inference results
results/*
!results/.gitkeep
!results/*.csv
!results/*.md

# Logs and temporary diagnostics
*.log
kernel.errors.txt
*.tmp

# Ultralytics default training/inference outputs
runs/

# Python packaging artifacts
build/
dist/
*.egg-info/
